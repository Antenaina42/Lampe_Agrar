# LAMPE AGRAR FINANZMANAGER
# Configuration de l'environnement de production et développement

# Base de données MySQL
DATABASE_URL="mysql://root:root@localhost:3306/lampe_agrar_db"

# Clé secrète pour les sessions et tokens d'authentification (générer une clé aléatoire forte en production)
AUTH_SECRET="lampe-agrar-secret-token-key-2026-production-secure"

# Port d'exécution de l'application
PORT=3000

# Langue par défaut de l'application (de, en, fr)
DEFAULT_LOCALE="de"

# Mode données de démonstration (true / false)
ENABLE_DEMO_DATA=true
